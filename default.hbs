<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8">
    <title>{{meta_title}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {{ghost_head}}

    <link rel="stylesheet" href="{{asset "css/default.css"}}">
    <link rel="stylesheet" href="{{asset "css/index.css"}}">
    <link rel="stylesheet" href="{{asset "css/post.css"}}">
    <link rel="stylesheet" href="{{asset "css/page.css"}}">
    <link rel="stylesheet" href="{{asset "css/author.css"}}">
    <link rel="stylesheet" href="{{asset "css/tag.css"}}">
    <link rel="stylesheet" href="{{asset "css/koenig.css"}}">

</head>

<body class="{{body_class}}">

    <!-- SITE HEADER -->
    <header class="site-header" id="siteHeader">
        <div class="header-inner">
            <div class="header-brand">
                <a class="header-logo" href="{{@site.url}}">
                    {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                    {{else}}
                    {{@site.title}}
                    {{/if}}
                </a>
            </div>

            <nav class="header-nav" id="headerNav" aria-label="Main navigation">
                {{navigation}}
            </nav>

            <div class="header-actions">
                <button class="gh-search-icon" data-ghost-search aria-label="Search">
                    {{> "icons/search"}}
                </button>
                <a href="#/portal/signup" class="subscribe-btn">Subscribe</a>
                <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle navigation menu"
                    aria-expanded="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Panel -->
        <div class="mobile-nav-panel" id="mobileNavPanel">
            <nav class="mobile-nav">
                {{navigation}}
            </nav>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="site-main">
        {{{body}}}
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-inner">
            <!-- Footer Top -->
            <div class="footer-top">
                <!-- Brand Section -->
                <div class="footer-brand">
                    <a href="{{@site.url}}" class="footer-logo">
                        {{#if @site.logo}}
                        <img src="{{@site.logo}}" alt="{{@site.title}}">
                        {{else}}
                        <span>{{@site.title}}</span>
                        {{/if}}
                    </a>
                    {{#if @site.description}}
                    <p class="footer-tagline">{{@site.description}}</p>
                    {{/if}}
                </div>

                <!-- Navigation Links -->
                <div class="footer-nav-section">
                    <h4 class="footer-heading">Navigation</h4>
                    <nav class="footer-nav" aria-label="Footer navigation">
                        {{navigation}}
                    </nav>
                </div>

                <!-- Secondary Navigation -->
                <div class="footer-nav-section">
                    <h4 class="footer-heading">Resources</h4>
                    <nav class="footer-nav" aria-label="Footer secondary navigation">
                        {{navigation type="secondary"}}
                    </nav>
                </div>

                <!-- Newsletter / Connect -->
                <div class="footer-connect">
                    <h4 class="footer-heading">Stay Connected</h4>
                    <p class="footer-connect-text">Subscribe for the latest updates</p>
                    <a href="#/portal/signup" class="footer-subscribe-btn">Subscribe</a>

                    <!-- Social Links -->
                    <div class="footer-social">
                        {{#if @site.facebook}}
                        <a href="{{facebook_url}}" class="footer-social-link" target="_blank" rel="noopener"
                            aria-label="Facebook">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="currentColor">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                            </svg>
                        </a>
                        {{/if}}
                        {{#if @site.twitter}}
                        <a href="{{twitter_url}}" class="footer-social-link" target="_blank" rel="noopener"
                            aria-label="X">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="currentColor">
                                <path
                                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                            </svg>
                        </a>
                        {{/if}}
                    </div>
                </div>
            </div>

            <!-- Footer Bottom -->
            <div class="footer-bottom">
                <p class="footer-copyright">© {{date format="YYYY"}} {{@site.title}}. All rights reserved.</p>
                <p class="footer-powered">Powered by <a href="https://ghost.org" target="_blank"
                        rel="noopener">Ghost</a></p>
            </div>
        </div>
    </footer>

    <script src="{{asset "js/main.js"}}" defer></script>
    {{ghost_foot}}

</body>

</html>