<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8">
    <title>{{meta_title}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {{ghost_head}}

    <link rel="stylesheet" href="{{asset "css/default.css"}}">
    <link rel="stylesheet" href="{{asset "css/index.css"}}">
    <link rel="stylesheet" href="{{asset "css/post.css"}}">
    <link rel="stylesheet" href="{{asset "css/page.css"}}">
    <link rel="stylesheet" href="{{asset "css/author.css"}}">
    <link rel="stylesheet" href="{{asset "css/tag.css"}}">
    <link rel="stylesheet" href="{{asset " css/koenig.css"}}">

</head>

<body class="{{body_class}}">

    <!-- SITE HEADER -->
    <header class="site-header" id="siteHeader">
        <div class="header-inner">
            <div class="header-brand">
                <a class="header-logo" href="{{@site.url}}">
                    {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                    {{else}}
                    {{@site.title}}
                    {{/if}}
                </a>
            </div>

            <nav class="header-nav" id="headerNav" aria-label="Main navigation">
                {{navigation}}
            </nav>

            <div class="header-actions">
                <button class="gh-search-icon" data-ghost-search aria-label="Search">
                    {{> "icons/search"}}
                </button>
                <a href="#/portal/signup" class="subscribe-btn">Subscribe</a>
                <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle navigation menu"
                    aria-expanded="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Panel -->
        <div class="mobile-nav-panel" id="mobileNavPanel">
            <nav class="mobile-nav">
                {{navigation}}
            </nav>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="site-main">
        {{{body}}}
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-inner">
            <nav class="footer-nav">
                {{navigation type="secondary"}}
            </nav>
            <p>© {{date format="YYYY"}} {{@site.title}}</p>
        </div>
    </footer>

    <script src="{{asset "js/main.js"}}" defer></script>
    {{ghost_foot}}

</body>

</html>